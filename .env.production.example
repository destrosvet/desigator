# Copy to .env.production on the server; never commit real values.
DESIGATOR_IMAGE=desigator:REPLACE_WITH_TESTED_COMMIT
DATABASE_URL=postgresql://desigator:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/desigator
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_URL=https://desigator.cz
NEXTAUTH_URL=https://desigator.cz
APP_URL=https://desigator.cz
S3_ENDPOINT=https://REPLACE_WITH_PRIVATE_S3_ENDPOINT
S3_REGION=us-east-1
S3_BUCKET=desigator-uploads
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
S3_FORCE_PATH_STYLE=true
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM="Desigator <noreply@desigator.cz>"
