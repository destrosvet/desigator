DATABASE_URL=postgresql://desigator:desigator_password@localhost:5432/desigator_db
AUTH_SECRET=replace-with-a-random-secret-before-starting
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Optional S3-compatible storage. Bucket must remain private.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=desigator-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Used only by npm run db:admin; never commit real credentials.
# ADMIN_EMAIL=admin@example.cz
# ADMIN_PASSWORD=replace-with-at-least-12-random-characters

# Transactional email via Resend. Use a verified sender domain.
RESEND_API_KEY=
RESEND_FROM="Desigator <noreply@desigator.cz>"
# Public origin used in reset links; HTTPS required in production.
APP_URL=http://localhost:3000
