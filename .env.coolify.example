APP_URL=https://desigator.example.cz
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
S3_ENDPOINT=https://minio.example.cz
S3_REGION=us-east-1
S3_BUCKET=desigator-uploads
S3_ACCESS_KEY_ID=REPLACE_WITH_DEDICATED_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_DEDICATED_SECRET_KEY
S3_FORCE_PATH_STYLE=true
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM=Desigator <noreply@example.cz>

# Pouze pro jednorázový bootstrap konkrétní VUT instance:
ADMIN_EMAIL=admin@example.cz
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_ADMIN_PASSWORD
ADMIN_NAME=Administrátor
DEFAULT_TEACHER_EMAIL=teacher@example.cz
DEFAULT_TEACHER_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_PASSWORD
DEFAULT_TEACHER_NAME=Správce oboru průmyslový design
